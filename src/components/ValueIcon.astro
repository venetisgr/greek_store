---
/**
 * Circular line-icon badge, in the style of the tins' back-label icons
 * (hand / press / leaf / tree). Decorative — parent element labels it.
 */
import { C, ringTicks, oliveTreeMotif } from '../lib/art';

export type ValueIconKind = 'hand' | 'press' | 'leaf' | 'tree';

interface Props {
  kind: ValueIconKind;
}

const { kind } = Astro.props;

const motifs: Record<ValueIconKind, string> = {
  /* Hand reaching down to pick an olive. */
  hand: `<g fill="none" stroke="${C.bronze}" stroke-width="1.9" stroke-linecap="round">
<path d="M-12 -13 C -5 -18 5 -18 12 -13"/>
<path d="M-9 -15 C -12 -4 -9 4 -4 8"/>
<path d="M0 -17 C -1 -8 -0.5 0 0 5"/>
<path d="M9 -15 C 12 -4 9 4 4 8"/>
<path d="M-15 -7 C -17 1 -14 6 -8 10"/>
</g>
<circle cx="0" cy="12" r="5.5" fill="${C.oliveDark}"/>
<circle cx="-1.6" cy="10.4" r="1.4" fill="${C.goldBright}"/>`,
  /* Screw olive press with a falling drop. */
  press: `<g fill="none" stroke="${C.bronze}" stroke-width="1.8" stroke-linecap="round">
<path d="M-14 -17 H 14 M -14 -17 V 5 M 14 -17 V 5"/>
<path d="M0 -17 V -1" stroke-width="2.4"/>
<path d="M-3 -13 L 3 -11 M -3 -9 L 3 -7 M -3 -5 L 3 -3"/>
<path d="M-8 -1 H 8"/>
<path d="M-12 5 Q 0 13 12 5"/>
</g>
<path d="M0 12 q -3 4.5 0 7 q 3 -2.5 0 -7" fill="${C.amberDeep}"/>`,
  /* Single olive leaf with a golden drop. */
  leaf: `<ellipse cx="-2" cy="0" rx="14" ry="5" transform="rotate(-38 -2 0)" fill="none" stroke="${C.olive}" stroke-width="1.9"/>
<path d="M-12 9 L 8 -8" stroke="${C.olive}" stroke-width="1.4"/>
<path d="M-6 4 l 4 1 M-1 0 l 4 1 M4 -4 l 4 1" stroke="${C.olive}" stroke-width="1" fill="none"/>
<path d="M11 7 q -3 4.5 0 7 q 3 -2.5 0 -7" fill="${C.amberDeep}"/>`,
  /* Family olive tree (reused seal motif, smaller). */
  tree: `<g transform="scale(0.66)">${oliveTreeMotif}</g>`,
};
---

<svg viewBox="0 0 80 80" aria-hidden="true" focusable="false">
  <circle cx="40" cy="40" r="36" fill="#f7efdd" stroke={C.gold} stroke-width="1.5"></circle>
  <circle cx="40" cy="40" r="30.5" fill="none" stroke={C.gold} stroke-width="1" opacity="0.55"
  ></circle>
  <g set:html={ringTicks(40, 40, 31, 35, 24, C.gold, 0.55)} />
  <g transform="translate(40 41)" set:html={motifs[kind]} />
</svg>
