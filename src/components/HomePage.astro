---
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import { t, prefix, type Locale } from '../i18n/ui';
import { products } from '../data/products';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = prefix(locale);
---

<Base
  locale={locale}
  title={t(locale, 'nav.home')}
  description={t(locale, 'site.tagline')}
  path={`${p}/`}
>
  <section class="hero">
    <div class="container">
      <h1>{t(locale, 'home.heroTitle')}</h1>
      <p>{t(locale, 'home.heroText')}</p>
    </div>
  </section>
  <section id="products" class="container">
    <h2 class="section-title">{t(locale, 'nav.products')}</h2>
    <div class="product-grid">
      {products.map((product) => <ProductCard locale={locale} product={product} />)}
    </div>
  </section>
  <div class="center">
    <a class="cta" href={`${p}/order/`}>{t(locale, 'home.orderCta')}</a>
  </div>
</Base>
