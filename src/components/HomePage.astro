---
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import { t, prefix, type Locale } from '../i18n/ui';
import { products } from '../data/products';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = prefix(locale);
---

<Base
  locale={locale}
  title={t(locale, 'nav.home')}
  description={t(locale, 'site.tagline')}
  path={`${p}/`}
>
  <section class="hero">
    <div class="container">
      <h1>{t(locale, 'home.heroTitle')}</h1>
      <hr class="rule" />
      <p>{t(locale, 'home.heroText')}</p>
    </div>
  </section>
  <div class="meander" aria-hidden="true"></div>
  <section id="products" class="container">
    <h2 class="section-title">{t(locale, 'nav.products')}</h2>
    <div class="product-grid">
      {products.map((product) => <ProductCard locale={locale} product={product} />)}
      <article class="card line-mystery">
        <div class="card-art" aria-hidden="true"><span class="veiled">🏺</span></div>
        <h3>{t(locale, 'home.mysteryName')}</h3>
        <p class="card-region">{t(locale, 'home.mysteryTeaser')}</p>
        <a class="cta" href={`${p}/coming-soon/`}>{t(locale, 'nav.comingSoon')}</a>
      </article>
    </div>
  </section>
  <div class="center">
    <a class="cta" href={`${p}/order/`}>{t(locale, 'home.orderCta')}</a>
  </div>
</Base>
