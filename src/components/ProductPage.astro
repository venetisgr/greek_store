---
import Base from '../layouts/Base.astro';
import Emblem from './Emblem.astro';
import type { EmblemKind } from '../lib/art';
import { t, prefix, type Locale } from '../i18n/ui';
import type { Product } from '../data/products';

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const p = prefix(locale);

const lineEmblem: Record<Product['line'], EmblemKind> = {
  crete: 'olive',
  lakonia: 'helmet',
  honey: 'hive',
};
const emblem: EmblemKind =
  product.slug === 'lakonia-athinaiki' ? 'owl' : lineEmblem[product.line];
---

<Base
  locale={locale}
  title={product.name[locale]}
  description={product.subtitle[locale]}
  path={`${p}/products/${product.slug}/`}
>
  <div class={`product-head line-${product.line}`}>
    <div class="container">
      <div class="emblem" aria-hidden="true"><Emblem kind={emblem} /></div>
      <h1>{product.name[locale]}</h1>
      <hr class="rule" />
      <p>{product.subtitle[locale]}</p>
      <p class="motto">{product.motto[locale]}</p>
      <p class="product-meta">
        {t(locale, 'product.variety')}: {product.variety[locale]} ·
        {t(locale, 'product.region')}: {product.region[locale]} ·
        {product.size[locale]}
      </p>
    </div>
  </div>
  <div class="container">
    <div class="story">
      {product.story[locale].map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <blockquote class={`pull-quote line-${product.line}`}>
      {product.quote[locale]}
    </blockquote>
    <ul class="badges">
      {product.badges[locale].map((badge) => <li>{badge}</li>)}
    </ul>
    <div class="center">
      <a class="cta" href={`${p}/order/?product=${product.slug}`}>
        {t(locale, 'product.orderThis')}
      </a>
    </div>
  </div>
</Base>
