---
import Base from '../layouts/Base.astro';
import Emblem from './Emblem.astro';
import { typeSeal, type EmblemKind } from '../lib/art';
import { t, prefix, type Locale } from '../i18n/ui';
import type { Product } from '../data/products';

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const p = prefix(locale);

const lineEmblem: Record<Product['line'], EmblemKind> = {
  crete: 'olive',
  lakonia: 'helmet',
  honey: 'hive',
};
const emblem: EmblemKind =
  product.slug === 'lakonia-athinaiki' ? 'owl' : lineEmblem[product.line];
/* The Laconian Koroneiki hero carries the real tin medallion instead of the drawn helmet. */
const tinMedallion = emblem === 'helmet' ? '/images/spartan-helmet.png' : null;
---

<Base
  locale={locale}
  title={product.name[locale]}
  description={product.subtitle[locale]}
  path={`${p}/products/${product.slug}/`}
>
  <div class={`product-head line-${product.line}`}>
    <div class="container">
      <div class="emblem" aria-hidden="true">
        <span class="emblem-wrap">
          {tinMedallion ? <img class="emblem-medallion" src={tinMedallion} alt="" /> : <Emblem kind={emblem} />}
          <span class="type-seal" set:html={typeSeal(product.line === 'honey' ? 'honey' : 'oil')} />
        </span>
      </div>
      <h1>{product.name[locale]}</h1>
      <hr class="rule" />
      <p>{product.subtitle[locale]}</p>
      <p class="motto">{product.motto[locale]}</p>
      <p class="product-meta">
        {t(locale, 'product.variety')}: {product.variety[locale]} ·
        {t(locale, 'product.region')}: {product.region[locale]} ·
        {product.size[locale]}
      </p>
    </div>
  </div>
  <div class="container">
    <div class="story">
      {product.story[locale].map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <blockquote class={`pull-quote line-${product.line}`}>
      {product.quote[locale]}
    </blockquote>
    {product.image && (
      <figure class="tin-figure">
        <img
          src={product.image}
          alt={`${product.name[locale]} — ${t(locale, 'product.tinAlt')}`}
          loading="lazy"
        />
      </figure>
    )}
    <ul class="badges">
      {product.badges[locale].map((badge) => <li>{badge}</li>)}
    </ul>
    <div class="center">
      <a class="cta" href={`${p}/order/?product=${product.slug}`}>
        {t(locale, 'product.orderThis')}
      </a>
    </div>
  </div>
</Base>
