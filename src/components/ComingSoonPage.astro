---
import Base from '../layouts/Base.astro';
import Emblem from './Emblem.astro';
import { t, prefix, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = prefix(locale);
---

<Base
  locale={locale}
  title={t(locale, 'nav.comingSoon')}
  description={t(locale, 'comingSoon.text')}
  path={`${p}/coming-soon/`}
>
  <div class="meander" aria-hidden="true"></div>
  <div class="mystery">
    <div class="seal" aria-hidden="true"><Emblem kind="amphora" /></div>
    <h1>{t(locale, 'comingSoon.title')}</h1>
    <p>{t(locale, 'comingSoon.text')}</p>
    <p><em>{t(locale, 'comingSoon.hint')}</em></p>
  </div>
  <div class="meander" aria-hidden="true"></div>
</Base>
