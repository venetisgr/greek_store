---
import '../styles/global.css';
import { t, prefix, altPath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-prefixed path of the current page, e.g. '/el/products/honey/'. */
  path: string;
}

const { locale, title, description, path } = Astro.props;
const p = prefix(locale);
const other = altPath(locale, path);

const nav = [
  { href: `${p}/`, label: t(locale, 'nav.home') },
  { href: `${p}/#products`, label: t(locale, 'nav.products') },
  { href: `${p}/coming-soon/`, label: t(locale, 'nav.comingSoon') },
  { href: `${p}/order/`, label: t(locale, 'nav.order') },
];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t(locale, 'site.name')}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang={locale === 'en' ? 'el' : 'en'} href={other} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${p}/`}>{t(locale, 'site.name')}</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a class="lang-switch" href={other} rel="alternate">{t(locale, 'lang.switch')}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(locale, 'site.tagline')}</p>
      <p>© {t(locale, 'site.name')} — {t(locale, 'footer.rights')}</p>
    </footer>
    <script>
      // Motion layer: scroll reveals with stagger + gentle hero parallax.
      // Everything is skipped under prefers-reduced-motion, and .reveal is
      // only added from JS so content stays visible when scripts don't run.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = document.querySelectorAll(
          '.hero-arch, .card, .section-title, .values li, .order-band .container, .story p, .pull-quote, .badges li'
        );
        const perParent = new Map();
        targets.forEach((el) => {
          const parent = el.parentElement;
          const i = perParent.get(parent) ?? 0;
          perParent.set(parent, i + 1);
          el.classList.add('reveal');
          (el as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 90}ms`;
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
        );
        targets.forEach((el) => io.observe(el));

        const seal = document.querySelector<HTMLElement>('.hero-seal');
        const horizon = document.querySelector<HTMLElement>('.horizon');
        if (seal || horizon) {
          let ticking = false;
          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              const y = window.scrollY;
              if (seal) seal.style.transform = `translateY(${Math.min(y * 0.12, 42)}px)`;
              if (horizon) horizon.style.transform = `translateY(${Math.min(y * 0.05, 16)}px)`;
              ticking = false;
            });
          };
          addEventListener('scroll', onScroll, { passive: true });
        }
      }
    </script>
  </body>
</html>
