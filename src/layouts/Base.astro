---
import '../styles/global.css';
import { t, prefix, altPath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-prefixed path of the current page, e.g. '/el/products/honey/'. */
  path: string;
}

const { locale, title, description, path } = Astro.props;
const p = prefix(locale);
const other = altPath(locale, path);

const nav = [
  { href: `${p}/`, label: t(locale, 'nav.home') },
  { href: `${p}/#products`, label: t(locale, 'nav.products') },
  { href: `${p}/coming-soon/`, label: t(locale, 'nav.comingSoon') },
  { href: `${p}/order/`, label: t(locale, 'nav.order') },
];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t(locale, 'site.name')}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang={locale === 'en' ? 'el' : 'en'} href={other} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${p}/`}>{t(locale, 'site.name')}</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a class="lang-switch" href={other} rel="alternate">{t(locale, 'lang.switch')}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(locale, 'site.tagline')}</p>
      <p>© {t(locale, 'site.name')} — {t(locale, 'footer.rights')}</p>
    </footer>
  </body>
</html>
